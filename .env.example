# NeuroMem POC configuration.
# Copy to `.env` (never commit `.env`) and fill in secrets.

# --- OpenSearch ---
# Local Python processes use the Compose-managed cluster through localhost.
# Compose overrides these settings for its internal, unsecured POC network.
# For an external secured cluster, set its URL and credentials here and run
# the API outside the default managed Compose stack.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false

# --- OpenAI (chat completions + embeddings share one client) ---
# Hosted inference only; no local model or Jetson GPU is required.
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACTION=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MODEL_EMBEDDING=text-embedding-3-large

# --- Embeddings ---
EMBEDDING_DIM=3072
EMBEDDING_BATCH_MAX=128
EMBEDDING_TIMEOUT_S=30

# --- Health probes (cost guards for paid APIs) ---
# Set to true only when you want the health endpoints to actually hit OpenAI.
HEALTH_CHECK_LLM=false
HEALTH_CHECK_EMBEDDINGS=false

# --- Logging & agent identity ---
LOG_LEVEL=INFO
AGENT_ROLE_ID=default

# --- MCP (when running outside Compose) ---
MEMORY_API_URL=http://localhost:8000
